{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": [
                "--yes",
                "@upstash/context7-mcp"
            ]
        },
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "chrome-devtools-mcp"
            ]
        },
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        }
    }
}
