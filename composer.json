{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.40",
        "laravel/mcp": "^0.4.0",
        "laravel/reverb": "^1.4",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.15",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.6",
        "nesbot/carbon": "^3.8",
        "nwidart/laravel-modules": "^12.0",
        "spatie/laravel-cookie-consent": "^3.2|^4.0",
        "artesaos/seotools": "^1.3",
        "guzzlehttp/psr7": "2.7",
        "symfony/finder": "^7.2",
        "symfony/mime": "^7.2",
        "aerni/cloudflared": "^1.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^1.8",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Activity\\": "modules/Activity/app/",
            "Modules\\Analytics\\": "modules/Analytics/app/",
            "Modules\\Auth\\": "modules/Auth/app/",
            "Modules\\Backup\\": "modules/Backup/app/",
            "Modules\\Document\\": "modules/Document/app/",
            "Modules\\Health\\": "modules/Health/app/",
            "Modules\\Mail\\": "modules/Mail/app/",
            "Modules\\Mailer\\": "modules/Mailer/app/",
            "Modules\\MailsSettings\\": "modules/MailsSettings/app/",
            "Modules\\Media\\": "modules/Media/app/",
            "Modules\\Modules\\": "modules/Modules/app/",
            "Modules\\Notification\\": "modules/Notification/app/",
            "Modules\\Prestashop\\": "modules/Prestashop/app/",
            "Modules\\Pulse\\": "modules/Pulse/app/",
            "Modules\\Queue\\": "modules/Queue/app/",
            "Modules\\Role\\": "modules/Role/app/",
            "Modules\\System\\": "modules/System/app/",
            "Modules\\Telescope\\": "modules/Telescope/app/",
            "Modules\\User\\": "modules/User/app/",
            "Modules\\Warehouse\\": "modules/Warehouse/app/",
            "Modules\\Webhook\\": "modules/Webhook/app/"
        },
        "files": [
            "app/Helpers/Helper.php",
            "app/Helpers/Namespaced.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "app/Helpers/Helper.php",
            "app/Helpers/Namespaced.php"
        ]
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "docs": [
            "@php artisan docs:generate-commands"
        ],
        "setup:hooks": [
            "bash manual/setup-hooks.sh"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "modules/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "ignore-duplicates": true,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-scripts": false
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
